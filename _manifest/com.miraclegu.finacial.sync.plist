<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- 由 datalake/setup_tdx.py --install-timer 生成（路径取自当前仓库）。
     手改这个文件的话，下次 --install-timer 会覆盖它。 -->
<dict>
  <key>Label</key><string>com.miraclegu.finacial.sync</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/guhao/finacial/datalake/sync_daily.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/guhao/finacial/datalake</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>18</integer>
        <key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>/Users/guhao/finacial/datalake/_manifest/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/guhao/finacial/datalake/_manifest/launchd.err</string>
  <!-- 机器睡过了预定时刻，醒来补跑一次 —— 这正是不用 cron 的理由 -->
  <key>RunAtLoad</key><false/>
  <!-- 🔴 PATH 里必须有装了 duckdb 的那个 python3；launchd 默认环境很窄，
       缺了它 2/6 PIT 快照会 ModuleNotFoundError，而那一步漏一天不可逆 -->
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/opt/python@3.13/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
